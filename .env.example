# npm run setup creates .env.local with a random secret.
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=./data/community.db
ADMIN_EMAIL=admin@community.local
ADMIN_PASSWORD=CommunityAdmin123!
LOG_LEVEL=info
# Set true when serving over HTTPS; false supports local production preview.
COOKIE_SECURE=false
# For reverse-proxy hosting, set the exact public origin (e.g. https://events.example.com).
# APP_ORIGIN=https://events.example.com
